meta {
  name: List Favorites
  type: http
  seq: 1
}

get {
  url: {{uri}}/favorites?page=0&size=10&sort=createdAt,desc
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 10
  sort: createdAt,desc
  ~name: 
  ~city: 
}

headers {
  Authorization: Bearer {{authToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
