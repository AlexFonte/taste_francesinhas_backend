meta {
  name: List Pending
  type: http
  seq: 1
}

get {
  url: {{uri}}/francesinhas/pending
  body: none
  auth: bearer
}

params:query {
  page: 0
  size: 10
  sort: createdAt,asc
}

auth:bearer {
  token: {{authToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Solo ADMIN. Lista las francesinhas en estado PENDING ordenadas por antiguedad ASC.
  El frontend pide size=50 desde el dashboard para mostrar todas en la lista de moderacion.
}
