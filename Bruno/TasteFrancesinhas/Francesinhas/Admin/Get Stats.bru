meta {
  name: Get Stats
  type: http
  seq: 4
}

get {
  url: {{uri}}/francesinhas/stats
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Solo ADMIN. Devuelve { pending, accepted, rejected, total } para las cards del dashboard.
}

settings {
  encodeUrl: true
  timeout: 0
}