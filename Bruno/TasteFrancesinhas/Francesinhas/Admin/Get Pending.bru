meta {
  name: Get Pending
  type: http
  seq: 2
}

get {
  url: {{uri}}/francesinhas/pending/1
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

docs {
  Solo ADMIN. Devuelve el detalle de una francesinha sin filtrar por estado
  (pensado para ver propuestas en estado PENDING).
}

settings {
  encodeUrl: true
  timeout: 0
}