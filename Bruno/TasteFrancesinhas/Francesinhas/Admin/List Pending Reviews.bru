meta {
  name: List Pending Reviews
  type: http
  seq: 5
}

get {
  url: {{uri}}/francesinhas/pending/1/reviews
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

params:query {
  page: 0
  size: 10
  sort: createdAt,desc
}

docs {
  Solo ADMIN. Igual que /francesinhas/{id}/reviews pero sin filtrar por estado de la francesinha.
  Lo usa el detalle del admin para ver la review que dejo el proponente con la propuesta (PENDING).
}

settings {
  encodeUrl: true
  timeout: 0
}