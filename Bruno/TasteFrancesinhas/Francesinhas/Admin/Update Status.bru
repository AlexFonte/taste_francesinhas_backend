meta {
  name: Update Status
  type: http
  seq: 3
}

patch {
  url: {{uri}}/francesinhas/pending/1/status
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}


body:json {
  {
    "status": "ACCEPTED"
  }
}

docs {
  Solo ADMIN. Cambia el estado de una francesinha PENDING a ACCEPTED o REJECTED.
  PENDING en el body devuelve 400. La francesinha no puede salir de ACCEPTED/REJECTED a otro estado.
}

settings {
  encodeUrl: false
  timeout: 0
}