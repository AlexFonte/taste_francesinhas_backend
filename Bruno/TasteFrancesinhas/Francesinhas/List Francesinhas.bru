meta {
  name: List Francesinhas
  type: http
  seq: 1
}

get {
  url: {{uri}}/francesinhas?page=0&size=10&sort=createdAt,desc
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 10
  sort: createdAt,desc
  ~name:
  ~city:
  ~type:
  ~restaurantId:
}

docs {
  Lista francesinhas en estado ACCEPTED.
  Filtros opcionales: name (like), city (like), type (CLASICA|ESPECIAL|VEGANA|KEBAB|MARISCO), restaurantId (exacto).
  Para activar un filtro, quitar la tilde (~) delante.
}

settings {
  encodeUrl: true
  timeout: 0
}

