meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: {{uri}}/auth/refresh
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("authToken", body.accessToken);
  bru.setEnvVar("refreshToken", body.refreshToken);
}

settings {
  encodeUrl: false
  timeout: 0
}