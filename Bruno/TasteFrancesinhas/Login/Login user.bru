meta {
  name: Login user
  type: http
  seq: 1
}

post {
  url: {{uri}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@francesinhas.com",
    "password": "admin"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("authToken", body.accessToken);
  bru.setEnvVar("refreshToken", body.refreshToken);
  
    
}

settings {
  encodeUrl: false
  timeout: 0
}
