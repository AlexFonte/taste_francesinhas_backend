meta {
  name: List Restaurants
  type: http
  seq: 1
}

get {
  url: {{uri}}/restaurants?page=0&size=10&sort=name,asc
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 10
  sort: name,asc
  ~name:
  ~city:
}

docs {
  Publico. Solo devuelve restaurantes con active = true. Los restaurantes
  creados desde el flujo de proponer francesinha nacen inactivos y solo
  aparecen aqui cuando un admin aprueba alguna de sus francesinhas.
}

settings {
  encodeUrl: true
  timeout: 0
}

