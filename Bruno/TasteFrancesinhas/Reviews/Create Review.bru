meta {
  name: Create Review
  type: http
  seq: 2
}

post {
  url: {{uri}}/francesinhas/53/reviews
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  ~ Authorization: Bearer {{authToken}}
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "scoreFlavor": 5,
    "scoreSauce": 4,
    "scoreBread": 5,
    "scorePresentation": 5,
    "comment": "La mejor francesinha de Viana, volvere a proparla otra vez !!!"
  }
}

docs {
  Solo USER. Cada score entre 1 y 5.
  Flag opcional `"propuesta": true` cuando se llama desde el flujo de proponer
  (la francesinha esta en PENDING). Si se omite o es false, busca en ACCEPTED.
}

settings {
  encodeUrl: false
  timeout: 0
}

