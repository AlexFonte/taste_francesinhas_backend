meta {
  name: Create Review
  type: http
  seq: 2
}

post {
  url: {{uri}}/francesinhas/53/reviews
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "scoreFlavor": 5,
    "scoreSauce": 4,
    "scoreBread": 5,
    "scorePresentation": 5,
    "comment": "La mejor francesinha de Viana, volvere a proparla otra vez !!!"
  }
  
}

settings {
  encodeUrl: false
  timeout: 0
}
