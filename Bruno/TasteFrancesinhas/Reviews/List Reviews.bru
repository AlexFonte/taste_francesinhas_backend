meta {
  name: List Reviews
  type: http
  seq: 1
}

get {
  url: {{uri}}/francesinhas/1/reviews?page=0&size=10&sort=createdAt,desc
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 10
  sort: createdAt,desc
}

docs {
  Lista paginada de reviews. Solo funciona con francesinhas en estado ACCEPTED.
  La review del proponente de una francesinha PENDING viaja embebida en el DTO de
  GET /francesinhas/pending/{id} (campo userReview), no en este endpoint.
}

settings {
  encodeUrl: true
  timeout: 0
}